[Unit]
Description=Frogdash local Wi-Fi hotspot broker
After=NetworkManager.service
Requires=NetworkManager.service
ConditionPathExists=/etc/frogdash/hotspot.json

[Service]
Type=simple
User=root
Group=frogdash-connect
WorkingDirectory=/opt/frogdash
RuntimeDirectory=frogdash-connect
RuntimeDirectoryMode=0750
ExecStart=/opt/frogdash/.venv/bin/python -m hardware.frogdash.hotspot_helper
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
UMask=0117

[Install]
WantedBy=multi-user.target
