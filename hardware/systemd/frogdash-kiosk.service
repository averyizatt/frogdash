# Install as a USER service in an existing graphical session.
[Unit]
Description=Frogdash Chromium kiosk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/chromium --kiosk --no-first-run --disable-session-crashed-bubble http://127.0.0.1:8080/
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
