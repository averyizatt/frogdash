# Install as a USER service in an existing graphical session.
[Unit]
Description=Frogdash Chromium kiosk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /opt/frogdash/tools/launch_kiosk.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
