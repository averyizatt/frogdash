[Unit]
Description=Update Frogdash from GitHub and restart it
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/frogdash/tools/frogdash_update.sh
# Wi-Fi switching, the pull, the health check after the restart and a possible rollback,
# then the Pi setup, which on its first run downloads Java and TunerStudio.
TimeoutStartSec=3600
