[Unit]
Description=Read the dash screen's browser into memory early in boot (a sooner first frame)
# As early as the root file system allows: not after the usual basic system.
DefaultDependencies=no
After=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/bin/sh /opt/frogdash/tools/frogdash_warm.sh
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
