[Unit]
Description=Configure Frogdash MCP2515 SocketCAN at 500 kbit/s
BindsTo=sys-subsystem-net-devices-can0.device
After=sys-subsystem-net-devices-can0.device
Before=frogdash.service
JobTimeoutSec=10s

[Service]
Type=oneshot
RemainAfterExit=yes
# The bitrate can only be set while the link is down (it may already be up by hand).
ExecStartPre=-/usr/sbin/ip link set dev can0 down
ExecStart=/usr/sbin/ip link set dev can0 up type can bitrate 500000 restart-ms 100
ExecStop=/usr/sbin/ip link set dev can0 down
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
# Also start whenever can0 (re)appears, e.g. after an MCP2515 driver reset.
WantedBy=multi-user.target sys-subsystem-net-devices-can0.device
