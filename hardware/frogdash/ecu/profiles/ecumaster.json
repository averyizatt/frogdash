{
 "id": "ecumaster",
 "label": "ECUMaster EMU",
 "manufacturer": "ECUMaster (Poland)",
 "models": [
  "EMU Black",
  "EMU PRO (the same CAN stream)"
 ],
 "firmware": "EMU Black firmware 2.169 or later; EMU PRO firmware 216.1 or later",
 "bitrate": 500000,
 "extended": false,
 "timeout_s": 1.0,
 "status": "simulated",
 "source": {
  "title": "EMU Black User Manual, 6. CAN Stream",
  "url": "https://www.ecumaster.com/files/EMU_BLACK/EMU_BLACK_manual.pdf",
  "version": "Document version 1.4, firmware 2.169 or later, published 9 July 2026",
  "also": [
   "https://www.ecumaster.com/files/EMU_PRO/EMU_PRO_Manual.pdf (document version 1.1, 18 April 2025: the same structure)",
   "https://www.ecumaster.com/files/ADU/AN/emuBlack.pdf (ADU application note rev 1.01: the stream settings)"
  ]
 },
 "base": {
  "default": "0x600",
  "setting": "EMU stream base ID (HEX), in the EMU client: CAN, Serial / CAN"
 },
 "setup": [
  "EMU Black: in the EMU Black client, CAN, Serial / CAN: tick \"Send EMU stream over CAN-Bus\" and set \"CAN-Bus speed\" to 500 kbps (its default is 1 Mbps; the dash's bus runs at 500 kbps).",
  "EMU PRO: connect the dash to CAN 2 (500 kbps by default); CAN 1 is fixed at 1 Mbps.",
  "The stream starts at \"EMU stream base ID\" 0x600 and uses 8 IDs. If it is moved, set the same number as ecu.base_id in the dash.",
  "Switch on the EMU's 120 ohm terminator only if it is an end of the bus."
 ],
 "notes": "Oil and fuel pressure are sent in steps of 1/16 bar and given here in kPa. Lambda is given as lambda (ecu.lambda1); the dash's AFR gauge shows it as AFR (lambda x 14.7). Fields the EMU PRO leaves unused (lambda correction, traction RPM, PWM 2, some output flags) simply stay at their raw value there. Lambda correction is a factor around 100% (75-125%).",
 "tuner": {
  "name": "EMU Black Client (EMU Black); EMU PRO client software",
  "runs_on_dash": false,
  "connection": "EMU Black: USB-C straight to a Windows computer. EMU PRO: a USB-to-CAN interface (ECUMaster USBtoCAN, Peak or Kvaser)",
  "url": "https://www.ecumaster.com/downloads/",
  "status": "untested"
 },
 "check": [
  [
   "+0",
   "Engine (RPM, throttle, intake air, MAP)"
  ],
  [
   "+2",
