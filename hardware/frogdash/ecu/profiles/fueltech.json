{
 "id": "fueltech",
 "label": "FuelTech",
 "manufacturer": "FuelTech (Brazil)",
 "models": [
  "FT500 (IDs 0x14000600-0x14000608)",
  "FT600, FT550, FT450 (IDs 0x14080600-0x14080608)"
 ],
 "firmware": "FTCAN 2.0 simplified broadcast",
 "bitrate": 1000000,
 "extended": true,
 "timeout_s": 1.0,
 "status": "simulated",
 "source": {
  "title": "FTCAN 2.0 protocol: Real time simple broadcast and Simplified packets, MeasureID table",
  "url": "https://files.fueltech.net/manual/Ingles/Protocol_FTCAN20.pdf",
  "version": "Revision 044 (17/09/2026)"
 },
 "setup": [
  "The dash's CAN bus must run at 1 Mbit/s (ecu.bitrate 1000000): FTCAN 2.0 is 1 Mbit/s with 29-bit IDs.",
  "The ECU sends the simplified packets (fixed measures, 100 Hz); make sure its CAN output is on in FTManager or on the ECU."
 ],
 "notes": "Only the simplified packets are read; the full FTCAN 2.0 stream (MeasureIDs, segmented packets) is not. Measures whose unit the protocol does not give (pit limit, heading, shock sensors, G-force, yaw, fuel consumption) are left out. MAP and the pressures come in bar and are given here in kPa; the protocol does not say whether MAP is absolute or relative to the atmosphere, so check it against the barometer with the engine off. Gear: -2 park, -1 reverse, 0 neutral. Lambda is given as lambda (ecu.lambda1).",
 "tuner": {
  "name": "FTManager",
  "runs_on_dash": false,
  "connection": "USB to a Windows computer, or the ECU's own touch screen",
  "url": "https://www.fueltech.net/pages/software",
  "status": "untested"
 },
 "check": [
  [
   "0x14080600",
   "TPS, MAP, temperatures (FT600/550/450)"
  ],
  [
   "0x14000600",
   "TPS, MAP, temperatures (FT500)"
  ]
 ],
