{
 "id": "rusefi",
 "label": "rusEFI",
 "manufacturer": "rusEFI (open source)",
 "models": [
  "rusEFI boards (Proteus, uaEFI, Hellen and others) with the verbose CAN broadcast"
 ],
 "firmware": "rusEFI firmware of November 2025 (rusefi/rusefi bfde8f4)",
 "bitrate": 500000,
 "extended": false,
 "timeout_s": 1.0,
 "status": "simulated",
 "source": {
  "title": "rusEFI_CAN_verbose.dbc and can_verbose.cpp (rusEFI verbose CAN broadcast)",
  "url": "https://github.com/rusefi/rusefi/blob/bfde8f4945ecd33a9d3090b20aefba1521675801/firmware/controllers/can/rusEFI_CAN_verbose.dbc",
  "version": "rusefi/rusefi commit bfde8f4 (2025-11-20)",
  "also": [
   "https://github.com/rusefi/rusefi/blob/bfde8f4945ecd33a9d3090b20aefba1521675801/firmware/controllers/can/can_verbose.cpp",
   "https://wiki.rusefi.com/CAN-Broadcast-for-Dashboards/"
  ]
 },
 "base": {
  "default": "0x200",
  "setting": "verboseCanBaseAddress (CAN settings in TunerStudio)"
 },
 "setup": [
  "In TunerStudio with the rusEFI project: CAN settings, turn on \"CAN broadcast using custom rusEFI protocol\" (enableVerboseCanTx).",
  "Leave the verbose CAN IDs at \"11 bit\" (rusefiVerbose29b off) and the CAN speed at 500 kbps (both the defaults).",
  "The broadcast starts at ID 0x200 (512) and uses 12 IDs. In a car with the Frogdash comfort module or gateway (which use 0x200-0x20F), move it to a free range, for example 0x400 (1024), and set the same number as ecu.base_id in the dash.",
  "It is sent every canSleepPeriodMs (50 ms by default), five times slower while TunerStudio is connected over CAN."
 ],
 "notes": "Lambda is given as lambda (ecu.lambda1), oil and fuel pressure in kPa (the high-pressure GDI sensor is sent in 0.1 bar steps); the dash's AFR gauge shows it as AFR (lambda x 14.7), and the pressures in psi. Values the ECU has no sensor for are sent as 0 (or -1 for pedal and throttles). rusEFI's Haltech-format and other dash broadcasts are separate options and not read by this profile.",
 "tuner": {
  "name": "TunerStudio with the rusEFI project, or rusEFI's own console",
  "runs_on_dash": true,
  "connection": "The board's USB (a serial port), or TunerStudio over CAN through rusEFI's CAN-to-TCP proxy",
  "url": "https://wiki.rusefi.com/TS-over-CAN/",
  "status": "untested"
 },
 "check": [
  [
   "+1",
   "Speeds (RPM, timing, vehicle speed)"
  ],
  [
   "+3",
   "Sensors (MAP, coolant, intake air, fuel level)"
  ]
 ],
