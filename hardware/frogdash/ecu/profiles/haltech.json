{
 "id": "haltech",
 "label": "Haltech",
 "manufacturer": "Haltech (Australia)",
 "models": [
  "Elite series ECUs",
  "Nexus series ECUs and VCUs"
 ],
 "firmware": "Nexus 1.25 or later; Elite 3.11 or later (earlier versions support parts of the protocol)",
 "bitrate": 1000000,
 "extended": false,
 "timeout_s": 1.5,
 "status": "simulated",
 "source": {
  "title": "Haltech ECU Broadcast CAN Protocol",
  "version": "Document version 2.0",
  "url": "https://support.haltech.com/portal/en/kb/articles/haltech-can-ecu-broadcast-protocol",
  "also": [
   "https://support.haltech.com/portal/en/kb/articles/haltech-can-protocol-specification"
  ]
 },
 "setup": [
  "The dash's CAN bus must run at 1 Mbit/s (ecu.bitrate 1000000), as Haltech's CAN does.",
  "Nexus firmware 1.25 or later, Elite 3.11 or later (check in NSP while connected).",
  "Fixed IDs 0x360-0x3E5 (and more the profile does not read yet); they cannot be moved."
 ],
 "notes": "Pressures other than MAP and baro are given as gauge pressure (Haltech sends them absolute; 101.3 kPa taken off, as its document says). Temperatures come in 0.1 K. Lambda is given as lambda (ecu.lambda1-4). Frames past 0x3E5 (0x3E6-0x3F3, 0x469-0x477, 0x6F0-0x701) are in the document but not read by this profile yet.",
 "tuner": {
  "name": "NSP (Nexus Software Programmer); ESP for older Elite firmware",
  "runs_on_dash": false,
  "connection": "USB to a Windows computer",
  "url": "https://www.haltech.com/",
  "status": "untested"
 },
 "check": [
  [
   "0x360",
   "RPM, MAP, throttle (50 Hz)"
  ],
  [
   "0x3E0",
   "Coolant, intake air, fuel and oil temperature (5 Hz)"
  ]
 ],
