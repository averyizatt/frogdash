# Copy to /etc/default/frogdash. Also supports explicit commands from the controls UI.
FROGDASH_ARGS="--interface can0 --gpsd --log-dir /var/lib/frogdash/logs"
# MLG defaults: 20 Hz, new file every 30 minutes or 32 MiB, 2 GiB total,
# 256 MiB minimum free disk space. Only recorder-owned logs are rotated.
# Optional flags: --log-hz 20 --log-minutes 30 --log-file-mib 32
#                 --log-total-mib 2048 --log-min-free-mib 256
# Race history/start-finish persist at /var/lib/frogdash/race.json by default.
# Optional: --race-file /var/lib/frogdash/race.json. Timing requires --gpsd.
# Remove --log-dir to disable recording. Keep it when changing GPS options below.
# To use USB GPS locally while CCM still owns 0x203:
# FROGDASH_ARGS="--interface can0 --gpsd --gps-no-transmit"
# Without USB GPS, receive the CCM's GPS frames instead:
# FROGDASH_ARGS="--interface can0"
